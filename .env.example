# ===== 数据库（PostgreSQL）=====
# 开发/测试可不填：交易功能将 fail closed（没有持久化就没有交易）
DATABASE_URL=postgres://user:password@localhost:5432/ai_quant_trading

# ===== 会话/登录 =====
# 生产必填；开发环境缺省时使用进程级随机 secret（重启后会话失效）
JWT_SECRET=
# 单用户登录（密码只存 SHA-256 hex，禁止明文）
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# 可选：外部 OAuth（无则只用本地登录）
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ===== Longbridge OpenAPI（只从环境读取，禁止写入源码）=====
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_HTTP_URL=https://openapi.longportapp.com

# ===== 交易闸门（默认全关，paper-only）=====
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false

# ===== 可选数据源（缺失时策略标记 dataQuality，不伪造数据）=====
GEMINI_API_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
